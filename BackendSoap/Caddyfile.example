# Reemplazar por un dominio realmente controlado y configurar DNS hacia la máquina.
# HTTPS es obligatorio para el cliente Android.
cuando-llega.example.com {
    encode gzip
    reverse_proxy 127.0.0.1:8787
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
    }
}
