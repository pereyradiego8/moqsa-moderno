# SOLO EN SERVIDOR. No compartir ni subir .env con claves.
# Usar URL HTTPS, si el proveedor dispone de ella.
SOAP_ENDPOINT=https://endpoint-autorizado.example.com/ModuloParadas/SWParadas.asmx
SOAP_USER=
SOAP_PASSWORD=
SOAP_ENTITY=
SOAP_CITY=QUILMES
SOAP_COMPANIES=191,7
SOAP_APP_CODE=
SOAP_RECHARGE_ENDPOINT=
SOAP_RECHARGE_USER=
SOAP_RECHARGE_PASSWORD=
# Solo para pruebas internas del servidor heredado, y únicamente con autorización:
ALLOW_LEGACY_HTTP=false
PORT=8787
HOST=127.0.0.1
